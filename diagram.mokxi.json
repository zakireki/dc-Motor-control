  "projects": {
    "*": {
      "files": {
        "sketch.ino": "// Mokxi.\n// This circuit has no board, so Run simulates the parts only.\n// Add a board and pick a program in its Firmware panel: the editor then shows\n// that program's source, and Run builds what you type here for that board.\n\nvoid setup() {\n  pinMode(13, OUTPUT);\n  Serial.begin(115200);\n}\n\nvoid loop() {\n  digitalWrite(13, HIGH);\n  delay(500);\n  digitalWrite(13, LOW);\n  delay(500);\n}\n"
      },
      "main": "sketch.ino"
    },
    "uno1": {
      "files": {
        "sketch.ino": "\n#include \"MotorDriver.h\"\n#include \"UltrasonicSensor.h\"\n\n\nMotorDriver car(1,2,4,7,3,5);\nUltrasonicSensor sensor(9 , 10);\nvoid setup() {\n  car.initPins();\n  car.setSpeed(255);\n  Serial.begin(9600);\n\n  sensor.initPins();\n}\nvoid loop() {\n\n  Serial.println(sensor.readCm());\n  delay(200);\n\n car.moveForward();\n  delay(2000);\n    car.stopRobot();\n   delay(2000);\n  \n  car.turnRight();\n  delay(2000);\n    car.stopRobot();\n   delay(2000);\n  \n  car.turnLeft();\n  delay(2000);\n   car.stopRobot();\n  delay(2000);\n  \n\n}\n  \n",
        "MotorDriver.cpp": "#include \"MotorDriver.h\"\n\nMotorDriver::MotorDriver(int rFwd, int rBwd, int lFwd, int lBwd, int speedA, int speedB) {\n  rightMotorForward = rFwd;\n  rightMotorBackward = rBwd;\n  leftMotorForward = lFwd;\n  leftMotorBackward = lBwd;\n  \n  pinSpeedA = speedA;\n  pinSpeedB = speedB;\n}\n\nvoid MotorDriver::initPins() {\n  pinMode(rightMotorForward, OUTPUT);\n  pinMode(rightMotorBackward, OUTPUT);\n  pinMode(leftMotorForward, OUTPUT);\n  pinMode(leftMotorBackward, OUTPUT);\n  pinMode(pinSpeedA, OUTPUT);\n  pinMode(pinSpeedB, OUTPUT);\n}\n\nvoid MotorDriver::setSpeed(int speed) {\n  analogWrite(pinSpeedA, speed);\n  analogWrite(pinSpeedB, speed);\n}\n\nvoid MotorDriver::moveForward() {\n  digitalWrite(rightMotorForward, HIGH);\n  digitalWrite(rightMotorBackward, LOW);\n  digitalWrite(leftMotorForward, HIGH);\n  digitalWrite(leftMotorBackward, LOW);\n}\n\nvoid MotorDriver::turnRight() {\n  digitalWrite(rightMotorForward, LOW);\n  digitalWrite(rightMotorBackward, HIGH);\n  digitalWrite(leftMotorForward, HIGH);\n  digitalWrite(leftMotorBackward, LOW);\n}\n\nvoid MotorDriver::turnLeft() {\n  digitalWrite(rightMotorForward, HIGH);\n  digitalWrite(rightMotorBackward, LOW);\n  digitalWrite(leftMotorForward, LOW);\n  digitalWrite(leftMotorBackward, HIGH);\n}\n\nvoid MotorDriver::stopRobot() {\n  digitalWrite(rightMotorForward, LOW);\n  digitalWrite(rightMotorBackward, LOW);\n  digitalWrite(leftMotorForward, LOW);\n  digitalWrite(leftMotorBackward, LOW);\n}\n\n\n",
        "MotorDriver.h": "#pragma once\n\n#include <Arduino.h>\n\nclass MotorDriver {\n  private:\n    int rightMotorForward;\n    int rightMotorBackward;\n    int leftMotorForward;\n    int leftMotorBackward;\n    int pinSpeedA;\n    int pinSpeedB;\n\n  public:\n    MotorDriver(int rFwd, int rBwd, int lFwd, int lBwd, int speedA, int speedB);\n  \n    void initPins();\n    void setSpeed(int speed);\n    void moveForward();\n    void turnRight();\n    void turnLeft();\n    void stopRobot();\n};\n\n\n",
        "UltrasonicSensor.h": "#pragma once\n#include <Arduino.h>\n\n\nclass UltrasonicSensor{\n\n  private:\n\n  uint8_t trig ;\n  uint8_t echo ;\n  public:\n  UltrasonicSensor(uint8_t t, uint8_t e);\n   void initPins();\n   float readCm(); \n};\n\n\n\n\n\n\n\n\n\n\n\n",
        "UltrasonicSensor.cpp": "#include\"UltrasonicSensor.h\"\n\nUltrasonicSensor::UltrasonicSensor(uint8_t t, uint8_t e) : trig(t) ,echo(e) {};\n \n\nvoid UltrasonicSensor::initPins(){\n  pinMode(trig , OUTPUT);\n  pinMode(echo , INPUT);\n};\n\nfloat UltrasonicSensor::readCm(){\n\n  digitalWrite(trig , LOW);\n  delayMicroseconds(2);\n\n  digitalWrite(trig, HIGH);\n    delayMicroseconds(10);\n\n  long us = pulseIn(echo , HIGH , 25000 );\n  if(us ==0)\n    return 999;\n  return us * 0.0343f /2;\n  \n};"
      },
      "main": "sketch.ino"
    }
  }
